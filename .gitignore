# --- Secrets (never commit) ---
.env
config/credentials.json
config/token.json

# --- Runtime data (never commit) ---
data/*.db
data/*.db-journal
logs/*.log
!data/.gitkeep
!logs/.gitkeep

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# --- Editors / OS ---
.vscode/
.idea/
Thumbs.db
.DS_Store

# --- Test artifacts ---
.pytest_cache/
.coverage
htmlcov/